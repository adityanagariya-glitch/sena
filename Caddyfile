# SENA local backend gateway (Caddy) — host-run, NO docker / docker-compose / nginx.
# One port (:8080) fronts the whole chatbot stack + the Streamlit test UI.
#
# Listens on :8080 (was :8000 — that collided with the policy child, which binds 8000).
#
# RUN AS BACKGROUND SERVICES (no terminals to keep open). Install the three
# systemd units ONCE, then everything auto-starts and survives reboot:
#   cp services/ai_chatbot/sena-chatbot-gateway.service /etc/systemd/system/
#   cp services/ai_chatbot/sena-chatbot-ui.service      /etc/systemd/system/
#   cp sena-caddy.service                               /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now sena-chatbot-gateway sena-chatbot-ui sena-caddy
#
#   sena-chatbot-gateway → gateway :9000 (spawns staff :8601 + policy :8000)
#   sena-chatbot-ui      → Streamlit UI  :8502  (baseUrlPath=aichatbot)
#   sena-caddy           → this proxy    :8080
#
#   Open:  http://<host>:8080/aichatbot/
#
# Validate this file first:  caddy validate --config Caddyfile
:8080 {
	# ── AI Chatbot stack ────────────────────────────────────────────────────
	# Streamlit UI. Runs with --server.baseUrlPath=aichatbot, so the /aichatbot/
	# prefix is PRESERVED (handle, not handle_path). Caddy proxies WebSockets
	# automatically — needed for Streamlit's live stream.
	handle /aichatbot/* {
		reverse_proxy 127.0.0.1:8502
	}

	# Gateway API. Its routes already include the prefix (/ai-chatbot/route,
	# /ai-chatbot/healthz), so PRESERVE the path — do not strip.
	handle /ai-chatbot/* {
		reverse_proxy 127.0.0.1:9000
	}

	# Policy service — STRIP /policy/ so /policy/auth/login → /auth/login
	# (the fake_users.json login the Policy/Procedure chips use).
	handle_path /policy/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Staff service — STRIP /staff/ (direct access; the gateway reaches it on 8601).
	handle_path /staff/* {
		reverse_proxy 127.0.0.1:8601
	}

	# ── Other host-direct services (legacy local ports — only active if you run
	#    those services directly on the host on these ports) ──────────────────
	handle /v1/voice* {
		reverse_proxy 127.0.0.1:8082
	}
	handle /v1/approval* {
		reverse_proxy 127.0.0.1:8082
	}
	handle /v1/onboarding* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /ws/onboarding* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /v1/case-review* {
		reverse_proxy 127.0.0.1:8084
	}

	handle {
		respond "SENA local backend (Caddy). Open the chatbot UI at /aichatbot/" 200
	}
}
