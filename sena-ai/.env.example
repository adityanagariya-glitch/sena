# Sena AI/ML Backend — Environment variables
# Copy to .env and fill in real values. Never commit .env itself.

# Database (local dev defaults)
SENA_DATABASE_URL=postgresql+asyncpg://sena_app:localdev@localhost:5432/sena_ai

# Environment: development | staging | production
SENA_ENVIRONMENT=development

# Logging
SENA_LOG_LEVEL=DEBUG
SENA_LOG_FORMAT=text

# Service (override per service if needed)
SENA_SERVICE_NAME=sena-ai
SENA_SERVICE_VERSION=0.1.0

# ====================================================
# BLOCKED — populate after cloud provider is confirmed
# ====================================================

# Cloud provider (gcp | aws | azure)
# SENA_CLOUD_PROVIDER=

# LLM API (depends on cloud provider)
# SENA_LLM_API_KEY=
# SENA_LLM_ENDPOINT=
# SENA_LLM_MODEL=

# Embedding model (depends on cloud provider)
# SENA_EMBEDDING_MODEL=
# SENA_EMBEDDING_ENDPOINT=

# OCR engine (depends on cloud provider)
# SENA_OCR_ENGINE=
# SENA_OCR_ENDPOINT=

# Object storage (depends on cloud provider)
# SENA_STORAGE_BUCKET=
