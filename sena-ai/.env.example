# Environment Variables Template (.env.example)
# Copy to .env and fill in real values. Never commit .env itself.
#
# Database (local dev defaults):
# SENA_DATABASE_URL: PostgreSQL async connection string
# Default: postgresql+asyncpg://sena_app:localdev@localhost:5432/sena_ai
#
# Environment (development | staging | production):
# SENA_ENVIRONMENT: Deployment environment
# Default: development
#
# Logging:
# SENA_LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# SENA_LOG_FORMAT: json or text
#
# Service metadata:
# SENA_SERVICE_NAME: Service identifier
# SENA_SERVICE_VERSION: Semantic version
#
# BLOCKED - waiting for cloud provider decision:
# - Cloud provider selection (GCP/AWS/Azure)
# - LLM API keys and endpoints
# - Embedding model configuration
# - OCR engine endpoints
# - Object storage configuration
#
# These are populated after TECHNICAL_DECISIONS.md is finalized.

# Voice Service (Flow B) Configuration
SENA_AI_SERVICE_NAME=sena-voice
SENA_AI_SERVICE_VERSION=0.1.0
SENA_AI_ENVIRONMENT=development
SENA_AI_DEBUG=true
SENA_AI_HOST=0.0.0.0
SENA_AI_PORT=8082
SENA_AI_LOG_LEVEL=INFO

SENA_AI_AUTH_MODE=dev_header
SENA_AI_JWT_ISSUER=
SENA_AI_JWT_AUDIENCE=
SENA_AI_JWT_PUBLIC_KEY_PEM=

SENA_AI_AI_DB_URL=postgresql+asyncpg://sena_ai:sena_ai@ai-db:5432/sena_ai
SENA_AI_SHARED_DB_URL=postgresql+asyncpg://shared:shared@shared-db:5432/platform
SENA_AI_REDIS_URL=redis://redis:6379/0
SENA_AI_REDIS_LOCK_TTL_SECONDS=3600
SENA_AI_REDIS_SESSION_TTL_SECONDS=86400

SENA_AI_AWS_REGION=ap-southeast-2
SENA_AI_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
SENA_AI_BEDROCK_MAX_TOKENS=1200
SENA_AI_BEDROCK_TEMPERATURE=0.2

SENA_AI_LIVEKIT_API_KEY=replace_me
SENA_AI_LIVEKIT_API_SECRET=replace_me
SENA_AI_LIVEKIT_URL=wss://replace-me-livekit

SENA_AI_SNS_CASE_NOTE_TOPIC_ARN=arn:aws:sns:ap-southeast-2:111111111111:case-note-events

SENA_AI_RATE_LIMIT_START_PER_MINUTE=30
SENA_AI_RATE_LIMIT_TURN_PER_MINUTE=120
SENA_AI_MAX_CONCURRENT_SESSIONS_PER_USER=5
SENA_AI_PROVIDER_TIMEOUT_SECONDS=1.2
SENA_AI_PROVIDER_MAX_RETRIES=2

# Gemini API — used for personal details onboarding flow
# Get your key at https://aistudio.google.com → "Get API Key"
SENA_AI_GEMINI_API_KEY=paste_your_key_here
SENA_AI_GEMINI_MODEL_ID=gemini-2.0-flash
SENA_AI_GEMINI_LIVE_MODEL_ID=gemini-2.0-flash-live-001

# Case Review Service (port 8084)
SENA_AI_CASE_REVIEW_PORT=8084
SENA_AI_DRAFTING_SERVICE_URL=http://localhost:8085
SENA_AI_DRAFTING_SERVICE_API_KEY=
SENA_AI_CASE_NOTE_FETCH_LIMIT=10
# SENA_AI_GEMINI_REGION: Australian data residency — do not change for production
SENA_AI_GEMINI_REGION=australia-southeast1