# .gitignore - Files to exclude from version control
#
# Python artifacts:
# - __pycache__/, *.pyc, *.pyo, *.egg-info/
# - Virtual environments: .venv/, venv/, env/
# - Build artifacts: dist/, build/
#
# IDE/editor:
# - .vscode/, .idea/, *.swp, *.swo
#
# Secrets (CRITICAL - never commit):
# - .env, .env.local, .env.production
# - Any file with credentials, API keys, tokens
#
# Docker:
# - pgdata/ (PostgreSQL persistent volume)
#
# OS-specific:
# - .DS_Store (macOS), Thumbs.db (Windows)
#
# Testing/coverage:
# - .pytest_cache/, .coverage, htmlcov/, .mypy_cache/
#
# Migrations (Python compiled files only):
# - migrations/versions/*.pyc
#
# Intent: Ensure only Python source code is checked in
# Database data, virtual environments, IDE config not tracked
archive/

.venv/*