# --- onboarding service (port 8083) — copy to .env on EC2 and fill in ---

# Gemini Live (required)
SENA_AI_GEMINI_API_KEY=replace-me
SENA_AI_GEMINI_LIVE_MODEL_ID=gemini-3.1-flash-live-preview

# Webhook back to app backend (required for /complete)
SENA_AI_APP_WEBHOOK_URL=https://your-app-backend.example.com/webhooks/onboarding
SENA_AI_APP_WEBHOOK_SECRET=replace-me

# Feature flags
SENA_AI_ONBOARDING_GROUNDING_ENABLED=false
SENA_AI_ONBOARDING_CROSS_SCREEN_CONTEXT_ENABLED=true

# Tunables (defaults are fine for demo — uncomment only if changing)
# SENA_AI_SCREEN_STATE_MAX_BYTES=8192
# SENA_AI_RESUMPTION_HANDLE_TTL_SEC=600
# SENA_AI_RESUMPTION_REPLAY_TURNS=4
# SENA_AI_LOG_LEVEL=INFO
# SENA_AI_ENVIRONMENT=demo
