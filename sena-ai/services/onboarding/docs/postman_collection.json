{
  "info": {
    "name": "SENA Onboarding Voice API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST endpoints for the SENA NDIS onboarding voice service (port 8083). WebSocket protocol documented in docs/WS_PROTOCOL.md."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8083", "type": "string" },
    { "key": "session_id", "value": "", "type": "string" },
    { "key": "tenant_id", "value": "tenant-001", "type": "string" },
    { "key": "participant_id", "value": "participant-001", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/live"
          }
        },
        {
          "name": "Readiness (Redis ping)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/ready"
          }
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('session_id', json.session_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/onboarding/session",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participant_id}}\",\n  \"step\": \"personal_information\",\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"locale\": \"en-AU\",\n  \"schema\": {\n    \"step_id\": \"personal_information\",\n    \"step_label\": \"Personal Information\",\n    \"progress_percent\": 10,\n    \"sections\": [\n      {\n        \"id\": \"basics\",\n        \"label\": \"Basic Details\",\n        \"fields\": [\n          { \"id\": \"full_name\", \"label\": \"Full Name\", \"type\": \"text\", \"required\": true },\n          { \"id\": \"date_of_birth\", \"label\": \"Date of Birth\", \"type\": \"date\", \"required\": true }\n        ]\n      }\n    ]\n  },\n  \"initial_state\": {\n    \"basics\": { \"full_name\": \"Jane Smith\" }\n  }\n}"
            }
          }
        },
        {
          "name": "Get Session State",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/onboarding/session/{{session_id}}/state"
          }
        },
        {
          "name": "Update Session State (app write)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/v1/onboarding/session/{{session_id}}/state",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": {\n    \"basics\": {\n      \"full_name\": \"Jane Smith\",\n      \"date_of_birth\": \"1990-01-15\"\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Complete Session (fire webhook)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/onboarding/session/{{session_id}}/complete"
          }
        }
      ]
    },
    {
      "name": "Harness (dev only)",
      "item": [
        {
          "name": "Open Test Harness",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/harness"
          }
        },
        {
          "name": "Get Fixture Schema — personal_information",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/harness/fixtures/personal_information"
          }
        },
        {
          "name": "Get Fixture Schema — medical_information",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/harness/fixtures/medical_information"
          }
        }
      ]
    }
  ]
}
