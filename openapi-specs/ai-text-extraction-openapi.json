{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Extraction API",
    "description": "Extracts structured fields from identity documents using AWS Bedrock Nova Lite.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Utility"
        ],
        "summary": "Health",
        "description": "Returns 200 OK when the service is running.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/extract": {
      "post": {
        "tags": [
          "Extraction"
        ],
        "summary": "Extract From S3",
        "description": "Download a document from S3 by object key and extract identity fields.\n\nRequires a valid JWT in the Authorization header:\n  Authorization: Bearer <token>\n\nThe token is issued by the auth server (mobile team) and validated here.\nReturns a JSON object with the extracted identity fields.",
        "operationId": "extract_from_s3_extract_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/extract/local": {
      "post": {
        "tags": [
          "Local Testing"
        ],
        "summary": "Extract Local",
        "description": "Extract identity fields from a local file path.\n\nFOR LOCAL TESTING ONLY \u2014 this endpoint reads directly from the filesystem\nand should not be exposed in production.\n\nAccepts absolute file paths to .jpg, .jpeg, .png, .webp, .pdf, or .docx files.",
        "operationId": "extract_local_extract_local_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalExtractionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExtractionRequest": {
        "properties": {
          "s3_key": {
            "type": "string",
            "title": "S3 Key"
          }
        },
        "type": "object",
        "required": [
          "s3_key"
        ],
        "title": "ExtractionRequest",
        "description": "Request body for the production S3 endpoint.",
        "example": {
          "s3_key": "uploads/2024/passport.pdf"
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocalExtractionRequest": {
        "properties": {
          "file_path": {
            "type": "string",
            "title": "File Path"
          }
        },
        "type": "object",
        "required": [
          "file_path"
        ],
        "title": "LocalExtractionRequest",
        "description": "Request body for the local-testing endpoint.",
        "example": {
          "file_path": "C:/Users/BAPS/Documents/SENA_text-extraction/test_data/WA_Photo_card.jpg"
        }
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
