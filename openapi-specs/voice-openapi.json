{
  "openapi": "3.0.0",
  "info": {
    "title": "SENA Voice Service",
    "description": "AI voice agent for case note dictation and personal details collection",
    "version": "0.1.0",
    "contact": {
      "name": "SENA AI Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8082",
      "description": "Development server"
    },
    {
      "url": "https://api.sena.example.com/voice",
      "description": "Production server"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Health check - liveness",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "alive"
                    },
                    "service": {
                      "type": "string",
                      "example": "sena-voice"
                    },
                    "version": {
                      "type": "string",
                      "example": "0.1.0"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Health check - readiness",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "ai_database": {
                          "type": "string"
                        },
                        "shared_database": {
                          "type": "string"
                        },
                        "redis": {
                          "type": "string"
                        },
                        "bedrock": {
                          "type": "string"
                        },
                        "sns": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/session": {
      "post": {
        "summary": "Start dictation session",
        "tags": [
          "Dictation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/session/turn": {
      "post": {
        "summary": "Process dictation turn",
        "tags": [
          "Dictation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turn processed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/session/end": {
      "post": {
        "summary": "End dictation session",
        "tags": [
          "Dictation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/session/{session_id}": {
      "get": {
        "summary": "Get session status",
        "tags": [
          "Dictation"
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/personal-details/session": {
      "post": {
        "summary": "Start personal details session",
        "tags": [
          "Personal Details"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartPersonalDetailsRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartPersonalDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/personal-details/session/turn": {
      "post": {
        "summary": "Process personal details turn",
        "tags": [
          "Personal Details"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalDetailsTurnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turn processed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalDetailsTurnResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/personal-details/session/end": {
      "post": {
        "summary": "End personal details session",
        "tags": [
          "Personal Details"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndPersonalDetailsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndPersonalDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/approval/decision": {
      "post": {
        "summary": "Submit approval decision",
        "tags": [
          "Approval"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalDecisionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TokenUsage": {
        "type": "object",
        "description": "LLM token usage metrics including cache metrics",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Regular input tokens",
            "example": 2150
          },
          "output_tokens": {
            "type": "integer",
            "description": "Generated output tokens",
            "example": 450
          },
          "total_tokens": {
            "type": "integer",
            "description": "Sum of input + output tokens",
            "example": 2600
          },
          "cache_read_tokens": {
            "type": "integer",
            "description": "Tokens from cache hits (10% cost)",
            "example": 100
          },
          "cache_creation_tokens": {
            "type": "integer",
            "description": "Tokens used to create cache",
            "example": 50
          }
        }
      },
      "StartSessionRequest": {
        "type": "object",
        "required": [
          "objective",
          "participant_id",
          "staff_id",
          "shift_id"
        ],
        "properties": {
          "objective": {
            "type": "string",
            "enum": [
              "CASE_NOTE"
            ]
          },
          "participant_id": {
            "type": "string",
            "format": "uuid"
          },
          "staff_id": {
            "type": "string",
            "format": "uuid"
          },
          "shift_id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": "string",
            "default": "en-AU"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "StartSessionResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "lock_acquired": {
            "type": "boolean"
          },
          "livekit": {
            "type": "object"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "TurnRequest": {
        "type": "object",
        "required": [
          "session_id",
          "transcript",
          "transcript_confidence",
          "sequence_number"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "transcript": {
            "type": "string",
            "minLength": 1
          },
          "transcript_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "audio_duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "sequence_number": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TurnResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence_number": {
            "type": "integer"
          },
          "agent_reply": {
            "type": "string"
          },
          "draft_preview": {
            "type": "string"
          },
          "completeness_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "missing_topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "string",
            "example": "au.anthropic.claude-sonnet-4-6"
          },
          "latency_ms": {
            "type": "integer"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "EndSessionRequest": {
        "type": "object",
        "required": [
          "session_id",
          "ended_at"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "client_timezone": {
            "type": "string",
            "default": "Australia/Sydney"
          }
        }
      },
      "EndSessionResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "draft_id": {
            "type": "string",
            "format": "uuid"
          },
          "approval_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "case_note": {
            "type": "object"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "SessionStatusResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "turn_count": {
            "type": "integer"
          },
          "completeness_score": {
            "type": "number"
          },
          "missing_topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "StartPersonalDetailsRequest": {
        "type": "object",
        "required": [
          "participant_id",
          "staff_id",
          "shift_id"
        ],
        "properties": {
          "participant_id": {
            "type": "string",
            "format": "uuid"
          },
          "staff_id": {
            "type": "string",
            "format": "uuid"
          },
          "shift_id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": "string",
            "default": "en-AU"
          }
        }
      },
      "StartPersonalDetailsResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "lock_acquired": {
            "type": "boolean"
          },
          "livekit": {
            "type": "object"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "PersonalDetailsTurnRequest": {
        "type": "object",
        "required": [
          "session_id",
          "transcript",
          "transcript_confidence",
          "sequence_number"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "transcript": {
            "type": "string",
            "minLength": 1
          },
          "transcript_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "audio_duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "sequence_number": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PersonalDetailsTurnResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence_number": {
            "type": "integer"
          },
          "agent_reply": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completeness_score": {
            "type": "number"
          },
          "model": {
            "type": "string",
            "example": "gemini-3.5-flash"
          },
          "latency_ms": {
            "type": "integer"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "EndPersonalDetailsRequest": {
        "type": "object",
        "required": [
          "session_id",
          "ended_at"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EndPersonalDetailsResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "draft_id": {
            "type": "string",
            "format": "uuid"
          },
          "fields": {
            "type": "object"
          },
          "completeness_score": {
            "type": "number"
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "ApprovalDecisionRequest": {
        "type": "object",
        "required": [
          "approval_item_id",
          "decision",
          "reviewer_id"
        ],
        "properties": {
          "approval_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ]
          },
          "reviewer_id": {
            "type": "string",
            "format": "uuid"
          },
          "review_notes": {
            "type": "string",
            "default": ""
          }
        }
      },
      "ApprovalDecisionResponse": {
        "type": "object",
        "properties": {
          "approval_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "shared_case_note_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "delivered_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "HeaderAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-ID"
      }
    }
  }
}