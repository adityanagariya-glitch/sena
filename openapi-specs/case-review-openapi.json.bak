          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
