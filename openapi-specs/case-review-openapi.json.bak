    "/v1/restrictive-practices/bsp": {
      "post": {
        "tags": [
          "restrictive-practices"
        ],
        "summary": "Create Bsp",
        "description": "Register a new Behaviour Support Plan for a client.\n\nCalled by the platform backend when a practitioner's BSP is approved.\nOne row per (client_id, practice_type) combination. To replace an existing\nauthorisation, revoke the old record first then POST a new one.",
        "operationId": "create_bsp_v1_restrictive_practices_bsp_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BSPCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BSPResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/restrictive-practices/bsp/{client_id}": {
      "get": {
        "tags": [
          "restrictive-practices"
        ],
        "summary": "List Bsps",
        "description": "Return all BSP records for a given client, ordered by creation date descending.",
        "operationId": "list_bsps_v1_restrictive_practices_bsp__client_id__get",
