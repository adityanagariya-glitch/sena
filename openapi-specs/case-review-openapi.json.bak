    "/v1/restrictive-practices/voice/session": {
      "post": {
        "tags": [
          "restrictive-practices"
        ],
        "summary": "Create Rp Voice Session",
        "description": "Create a tenant-scoped RP voice session for case-note dictation.\n\nPass ``initial_values`` from ``POST /draft`` to pre-fill already-extracted\nfields; the voice assistant fills the remaining gaps interactively.",
        "operationId": "create_rp_voice_session_v1_restrictive_practices_voice_session_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
