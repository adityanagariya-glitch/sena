    "/v1/restrictive-practices/draft": {
      "post": {
        "tags": [
          "restrictive-practices"
        ],
        "summary": "Draft Case Note",
        "description": "Extract a voice transcript into a pre-filled structured case note draft.\n\nThe worker reviews and edits the returned fields before submitting.\nNo data is stored \u2014 this is a stateless AI extraction call.",
        "operationId": "draft_case_note_v1_restrictive_practices_draft_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDraftResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/restrictive-practices/draft/audio": {
      "post": {
        "tags": [
          "restrictive-practices"
        ],
        "summary": "Draft Case Note Audio",
        "description": "Transcribe an audio recording then extract it into a pre-filled case note draft.\n\nAccepts multipart/form-data with an audio file + shift metadata form fields.\nTranscription uses Amazon Transcribe (en-AU). No data is stored \u2014 stateless.\nRequires SENA_AI_TRANSCRIPTION_BUCKET to be set.",
        "operationId": "draft_case_note_audio_v1_restrictive_practices_draft_audio_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
