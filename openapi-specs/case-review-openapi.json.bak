            "type": "string",
            "title": "Severity",
            "default": "Low"
          },
          "incident_categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Incident Categories",
            "default": []
          },
          "ongoing_risk_present": {
            "type": "boolean",
            "title": "Ongoing Risk Present",
            "default": false
          },
          "participant_currently_safe": {
            "type": "boolean",
            "title": "Participant Currently Safe",
            "default": true
          },
          "staff_currently_safe": {
            "type": "boolean",
            "title": "Staff Currently Safe",
            "default": true
          },
          "emergency_services_required": {
            "type": "boolean",
            "title": "Emergency Services Required",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "incident_type",
          "incident_description",
          "risk_assessment",
          "reportable"
        ],
        "title": "_IncidentReportSection"
      },
      "_ReportingSection": {
        "properties": {
          "must_report": {
            "type": "boolean",
            "title": "Must Report"
          },
          "notify_within": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notify Within",
            "description": "e.g. '5 business days' or '24 hours'"
          },
          "notify_authority": {
            "type": "string",
            "title": "Notify Authority",
            "default": "NDIS Quality and Safeguards Commission"
          },
          "guidance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guidance"
          }
        },
        "type": "object",
        "required": [
          "must_report"
        ],
        "title": "_ReportingSection"
      },
      "_SubmissionSection": {
        "properties": {
          "case_note_id": {
            "type": "string",
            "title": "Case Note Id"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "worker_id": {
            "type": "string",
            "title": "Worker Id"
          },
          "screening_result": {
            "type": "string",
            "title": "Screening Result",
            "description": "'Flagged for detailed review' or 'Passed initial screening'"
          },
          "screening_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screening Summary"
          }
        },
        "type": "object",
        "required": [
          "case_note_id",
          "client_id",
          "worker_id",
          "screening_result"
        ],
        "title": "_SubmissionSection"
      },
      "_SummarySection": {
        "properties": {
          "ai_confidence": {
            "type": "number",
            "title": "Ai Confidence",
            "description": "AI confidence score 0.0\u20131.0"
          },
          "confidence_label": {
            "type": "string",
            "title": "Confidence Label",
            "description": "e.g. 'High', 'Medium', 'Low'"
          },
          "progress_identified": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Progress Identified",
            "description": "Positive observations from the shift",
            "default": []
          },
          "potential_risks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Potential Risks",
            "description": "Risk indicators noted",
            "default": []
          },
          "patterns_detected": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Patterns Detected",
            "description": "Behavioural or situational patterns",
            "default": []
          },
          "flagged_highlights": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flagged Highlights",
            "description": "Verbatim excerpts from the case note that warranted attention",
            "default": []
          },
          "note_quality_score": {
            "type": "number",
            "title": "Note Quality Score",
            "description": "Heuristic quality score 0.0\u20131.0",
            "default": 0.0
          },
          "note_quality_label": {
            "type": "string",
            "title": "Note Quality Label",
            "description": "'Premium' | 'Average' | 'Poor'",
            "default": "Average"
          },
          "quality_gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quality Gaps",
            "description": "Actionable suggestions for improving the note",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "ai_confidence",
          "confidence_label"
        ],
        "title": "_SummarySection"
      },
      "_VerdictSection": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/VerdictOutcome"
          },
          "risk_level": {
            "type": "string",
            "title": "Risk Level",
            "description": "Low | Medium | High | Critical | N/A"
          },
          "alert_required": {
            "type": "boolean",
            "title": "Alert Required"
          },
          "action_required": {
            "type": "string",
            "title": "Action Required",
            "description": "What must be done next, in plain English"
          },
          "next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next Steps",
            "description": "Ordered checklist of recommended investigation/response steps",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "risk_level",
          "alert_required",
          "action_required"
        ],
        "title": "_VerdictSection"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}