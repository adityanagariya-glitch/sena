{
  "openapi": "3.1.0",
  "info": {
    "title": "SENA Case Note Review API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Live",
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Ready",
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/case-review/context": {
      "post": {
        "tags": [
          "context"
        ],
        "summary": "Get Context",
        "description": "Fetch the last N case notes for a staff-client pair and return a rolling summary.\nIdempotent \u2014 re-calling with same notes returns cached summary (no LLM call).\nAdding new notes updates and compresses the rolling summary.",
        "operationId": "get_context_v1_case_review_context_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/case-review/classify": {
      "post": {
        "tags": [
          "classify"
        ],
        "summary": "Classify Paragraph",
        "description": "Classify a free-text paragraph into structured case note fields.\nReturns missing required fields and re-ask prompts if paragraph is thin.",
        "operationId": "classify_paragraph_v1_case_review_classify_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/case-review/review": {
      "post": {
        "tags": [
          "review"
        ],
        "summary": "Review Session",
        "description": "Analyse classified fields against rolling history.\nReturns risk flags, restrictive-practice categories (NDIS taxonomy),\nanomalies vs history, and improvement suggestions.\nImplemented in Phase D.",
        "operationId": "review_session_v1_case_review_review_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/case-review/incident/detect": {
      "post": {
        "tags": [
          "incident"
        ],
        "summary": "Detect Incident",
        "description": "Binary classifier: does this case note describe a reportable incident?\nIf yes, creates an IncidentDraft and returns draft_id for the autofill step.\nImplemented in Phase E.",
        "operationId": "detect_incident_v1_case_review_incident_detect_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentDetectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDetectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/case-review/incident/draft": {
      "post": {
        "tags": [
          "incident"
        ],
        "summary": "Draft Incident",
        "description": "Autofill incident form fields from case note text.\nStaff must review and confirm (PATCH /incident/{id}/confirm) before submit.\nImplemented in Phase E.",
        "operationId": "draft_incident_v1_case_review_incident_draft_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentDraftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDraftResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/case-review/incident/{incident_id}/confirm": {
      "patch": {
        "tags": [
          "incident"
        ],
        "summary": "Confirm Incident",
        "description": "Staff explicitly confirms the AI-autofilled incident draft.\nNDIS non-negotiable: no auto-submit without human confirmation.\nImplemented in Phase E.",
        "operationId": "confirm_incident_v1_case_review_incident__incident_id__confirm_patch",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Incident Id"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentConfirmResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/case-review/submit": {
      "post": {
        "tags": [
          "submit"
        ],
        "summary": "Submit Review",
        "description": "Final submit gate. Validates all flags acknowledged by staff, then writes\nto the case note register and routes any confirmed incident separately.\nBLOCKED on other engineer's register schema (Phase F).",
        "operationId": "submit_review_v1_case_review_submit_post",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aaaaaaaa-0000-0000-0000-000000000001",
              "title": "X-Tenant-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bbbbbbbb-0000-0000-0000-000000000002",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-User-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worker",
              "title": "X-User-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
