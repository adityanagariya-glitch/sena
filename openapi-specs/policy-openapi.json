    },
    "components": {
        "schemas": {
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LoginRequest": {
                "properties": {
                    "login_id": {
                        "type": "string",
                        "title": "Login Id"
                    },
                    "password": {
                        "type": "string",
                        "title": "Password"
                    }
                },
                "type": "object",
                "required": [
                    "login_id",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "QueryRequest": {
                "properties": {
                    "question": {
                        "type": "string",
                        "title": "Question"
                    },
                    "session_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Session Id"
                    },
                    "session_title": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Session Title"
                    },
                    "is_new_chat": {
                        "type": "boolean",
                        "title": "Is New Chat",
                        "default": false
                    }
                },
                "type": "object",
                "required": [
                    "question"
                ],
                "title": "QueryRequest"
            },
            "RenameRequest": {
                "properties": {
                    "session_id": {
                        "type": "string",
                        "title": "Session Id"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title"
                    }
                },
                "type": "object",
                "required": [
                    "session_id",
                    "title"
                ],
                "title": "RenameRequest"
            },
            "TriggerCleanupRequest": {
                "properties": {
                    "s3_key": {
                        "type": "string",
                        "title": "S3 Key"
                    }
                },
                "type": "object",
                "required": [
                    "s3_key"
                ],
                "title": "TriggerCleanupRequest"
            },
            "TriggerIngestionRequest": {
                "properties": {
                    "s3_key": {
                        "type": "string",
                        "title": "S3 Key"
                    }
                },
                "type": "object",
                "required": [
                    "s3_key"
                ],
                "title": "TriggerIngestionRequest"
            },
            "TurnsRequest": {
                "properties": {
                    "session_id": {
                        "type": "string",
                        "title": "Session Id"
                    }
                },
                "type": "object",
                "required": [
                    "session_id"
                ],
                "title": "TurnsRequest"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
