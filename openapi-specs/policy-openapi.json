        "/query/stream": {
            "post": {
                "summary": "Query Stream",
                "description": "SSE streaming. Events:\n    data: {\"type\": \"meta\",    \"session_id\": \"...\", \"label\": \"...\", \"sources\": [...]}\n    data: {\"type\": \"token\",   \"text\": \"...\"}\n    data: {\"type\": \"usage\",   \"input_tokens\": N, \"output_tokens\": N}\n    data: {\"type\": \"done\",    \"stop_reason\": \"end_turn\"}\n    data: {\"type\": \"blocked\", \"text\": \"...\", \"label\": \"...\"}\n    data: {\"type\": \"error\",   \"text\": \"...\"}",
                "operationId": "query_stream_query_stream_post",
                "parameters": [
                    {
                        "name": "authorization",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "Authorization"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
