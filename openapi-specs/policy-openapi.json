{
    "openapi": "3.1.0",
    "info": {
        "title": "SENA Policy/Procedure API",
        "description": "**Internal API — called by ai-chatbot only.** RAG (Retrieval-Augmented Generation) system for organizational policy and compliance procedures.\n\n**Main Query Endpoint:**\n- `POST /query/stream` → Answer policy and procedure questions using organization documents\n\n**Session Management:**\n- `POST /new_session` — Start a new conversation thread\n- `POST /list_sessions` — List all conversation sessions for the current user\n- `POST /get_turns` — Retrieve turns (messages) from a specific session\n- `POST /rename_session` — Rename a conversation session\n\n**Admin Document Ingestion:**\n- `POST /admin/trigger_ingestion` — Ingest a document from S3 into the vector database\n- `POST /admin/trigger_cleanup` — Remove a deleted document from vectors\n- `GET /admin/list_docs` — List all ingested documents for an organization\n\n**Streaming:** Query endpoint returns Server-Sent Events: `meta` (with sources) → `token` → `usage` → `done` (or `error`)",
        "version": "2.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Internal policy service (child process of ai-chatbot)"
        }
    ],
    "paths": {
        "/query/stream": {
            "post": {
                "tags": ["Query"],
                "summary": "Ask a policy or procedure question",
                "description": "Query the organization's policy and procedure documents using RAG. The system retrieves relevant document sections and uses Claude to answer the question.\n\n**Response includes:**\n- `meta` event with sources (which documents were used)\n- `token` events with the answer text\n- `usage` event with input/output token counts from Bedrock\n- `done` event when complete\n\nAll questions are scoped to the user's organization.",
                "operationId": "query_stream_query_stream_post",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"},
                        "description": "Bearer JWT token (validated by gateway, passed through)"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {"$ref": "#/components/schemas/QueryRequest"},
                            "examples": {
                                "policy_question": {
                                    "value": {
                                        "question": "What is the leave policy?",
                                        "is_new_chat": true
                                    }
                                },
                                "procedure_question": {
                                    "value": {
                                        "question": "What should I do if there's a safety incident?",
                                        "session_id": "sess-policy-001"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "SSE stream: meta (with sources) → token → usage → done",
                        "content": {
                            "text/event-stream": {
                                "example": "data: {\"type\": \"meta\", \"session_id\": \"policy-session-001\", \"sources\": [\"leave-policy-2024.pdf\", \"hr-handbook.pdf\"]}\n\ndata: {\"type\": \"token\", \"text\": \"According to our leave policy, you are entitled to...\"}\n\ndata: {\"type\": \"usage\", \"input_tokens\": 5240, \"output_tokens\": 480}\n\ndata: {\"type\": \"done\", \"stop_reason\": \"end_turn\"}\n"
                            }
                        }
                    }
                }
            }
        },
        "/new_session": {
            "post": {
                "tags": ["Sessions"],
                "summary": "Start a new conversation session",
                "description": "Creates a new conversation thread. Returns a session_id that can be used in subsequent `/query/stream` calls.",
                "operationId": "new_session_new_session_post",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"}
                    }
                ],
                "responses": {
                    "200": {
                        "description": "New session created",
                        "content": {
                            "application/json": {
                                "schema": {"type": "object"},
                                "example": {"session_id": "sess-policy-001", "created_at": "2026-06-09T10:30:00Z"}
                            }
                        }
                    }
                }
            }
        },
        "/list_sessions": {
            "post": {
                "tags": ["Sessions"],
                "summary": "List all conversation sessions",
                "description": "Returns all conversation sessions for the current user, with their titles and last update times.",
                "operationId": "list_sessions_list_sessions_post",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"}
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of sessions",
                        "content": {
                            "application/json": {
                                "schema": {"type": "object"},
                                "example": {
                                    "sessions": [
                                        {"session_id": "sess-001", "title": "Leave Policy Questions", "updated_at": "2026-06-09T10:30:00Z"},
                                        {"session_id": "sess-002", "title": "Safety Procedures", "updated_at": "2026-06-08T15:45:00Z"}
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/get_turns": {
            "post": {
                "tags": ["Sessions"],
                "summary": "Get conversation turns from a session",
                "description": "Retrieve all user/assistant messages from a specific conversation session.",
                "operationId": "get_turns_endpoint_get_turns_post",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"}
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {"$ref": "#/components/schemas/TurnsRequest"}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Conversation turns",
                        "content": {
                            "application/json": {
                                "schema": {"type": "object"},
                                "example": {
                                    "session_id": "sess-001",
                                    "turns": [
                                        {"role": "user", "text": "What is the leave policy?"},
                                        {"role": "assistant", "text": "The leave policy states..."}
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/rename_session": {
            "post": {
                "tags": ["Sessions"],
                "summary": "Rename a conversation session",
                "description": "Update the title of a conversation session.",
                "operationId": "rename_rename_session_post",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"}
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {"$ref": "#/components/schemas/RenameRequest"}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Session renamed successfully"
                    }
                }
            }
        },
        "/admin/trigger_ingestion": {
            "post": {
                "tags": ["Admin"],
                "summary": "Ingest a document from S3",
                "description": "Trigger ingestion of a document (PDF, txt, etc.) that's already been uploaded to S3.\n\n**Requirements:**\n- File must exist in S3 at the specified key\n- User must have coordinator or superadmin role\n- S3 key format: `{org_id}/{filename}`\n\n**Flow:**\n1. Validates user role and S3 key format\n2. Creates metadata sidecar\n3. Initiates ingestion job (2-3 mins)\n4. Updates status when complete\n\n**Synchronous** — waits for ingestion to complete before returning.",
                "operationId": "trigger_ingestion_admin_trigger_ingestion_post",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"}
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {"$ref": "#/components/schemas/TriggerIngestionRequest"},
                            "example": {"s3_key": "org-sunrise/leave-policy-2024.pdf"}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Ingestion complete",
                        "content": {
                            "application/json": {
                                "schema": {"type": "object"},
                                "example": {"s3_key": "org-sunrise/leave-policy-2024.pdf", "status": "COMPLETE", "vectors_created": 142}
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid key format or file not found in S3"
                    },
                    "403": {
                        "description": "Insufficient permissions (must be coordinator or superadmin)"
                    }
                }
            }
        },
        "/admin/trigger_cleanup": {
            "post": {
                "tags": ["Admin"],
                "summary": "Remove a deleted document from vectors",
                "description": "Trigger cleanup of vectors for a document that's been deleted from S3.\n\n**Requirements:**\n- File must be DELETED from S3 (confirm it's gone)\n- User must have coordinator or superadmin role\n- S3 key format: `{org_id}/{filename}`\n\n**Flow:**\n1. Validates user role and file is gone from S3\n2. Removes metadata sidecar\n3. Initiates vector cleanup job (2-3 mins)\n4. Updates status when complete\n\n**Synchronous** — waits for cleanup to complete before returning.",
                "operationId": "trigger_cleanup_admin_trigger_cleanup_post",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"}
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {"$ref": "#/components/schemas/TriggerCleanupRequest"},
                            "example": {"s3_key": "org-sunrise/old-policy.pdf"}
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Cleanup complete",
                        "content": {
                            "application/json": {
                                "schema": {"type": "object"},
                                "example": {"s3_key": "org-sunrise/old-policy.pdf", "status": "DELETED", "vectors_removed": 89}
                            }
                        }
                    },
                    "400": {
                        "description": "File still exists in S3 or cleanup already done"
                    }
                }
            }
        },
        "/admin/list_docs": {
            "get": {
                "tags": ["Admin"],
                "summary": "List ingested documents",
                "description": "List all ingested documents for an organization.\n\n**Permissions:**\n- Coordinators can list their own organization only\n- Superadmins can list any organization",
                "operationId": "list_docs_admin_list_docs_get",
                "parameters": [
                    {
                        "name": "org_id",
                        "in": "query",
                        "required": true,
                        "schema": {"type": "string"},
                        "description": "Organization ID to list documents for",
                        "example": "org-sunrise"
                    },
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": false,
                        "schema": {"type": "string"}
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of documents",
                        "content": {
                            "application/json": {
                                "schema": {"type": "object"},
                                "example": {
                                    "org_id": "org-sunrise",
                                    "documents": [
                                        {"s3_key": "org-sunrise/leave-policy-2024.pdf", "status": "COMPLETE", "ingested_at": "2026-06-09T10:00:00Z", "vectors": 142},
                                        {"s3_key": "org-sunrise/safety-handbook.pdf", "status": "COMPLETE", "ingested_at": "2026-06-08T15:30:00Z", "vectors": 287}
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Insufficient permissions"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": ["Health"],
                "summary": "Health check",
                "description": "Returns 200 when the policy service is healthy.",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "content": {
                            "application/json": {
                                "schema": {"type": "object"},
                                "example": {"status": "ok"}
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "QueryRequest": {
                "type": "object",
                "required": ["question"],
                "properties": {
                    "question": {
                        "type": "string",
                        "description": "The user's question about policy or procedures.",
                        "example": "What is the leave policy?"
                    },
                    "session_id": {
                        "type": "string",
                        "nullable": true,
                        "description": "Conversation ID to continue a thread. Omit or null to start fresh."
                    },
                    "session_title": {
                        "type": "string",
                        "nullable": true,
                        "description": "Title for a new conversation."
                    },
                    "is_new_chat": {
                        "type": "boolean",
                        "default": false,
                        "description": "True to start a new conversation."
                    }
                }
            },
            "TurnsRequest": {
                "type": "object",
                "required": ["session_id"],
                "properties": {
                    "session_id": {
                        "type": "string",
                        "description": "The session ID to fetch turns from."
                    }
                }
            },
            "RenameRequest": {
                "type": "object",
                "required": ["session_id", "title"],
                "properties": {
                    "session_id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    }
                }
            },
            "TriggerIngestionRequest": {
                "type": "object",
                "required": ["s3_key"],
                "properties": {
                    "s3_key": {
                        "type": "string",
                        "description": "S3 key of the file to ingest (format: org_id/filename)",
                        "example": "org-sunrise/leave-policy-2024.pdf"
                    }
                }
            },
            "TriggerCleanupRequest": {
                "type": "object",
                "required": ["s3_key"],
                "properties": {
                    "s3_key": {
                        "type": "string",
                        "description": "S3 key of the deleted file (format: org_id/filename)",
                        "example": "org-sunrise/old-policy.pdf"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Query",
            "description": "Policy and procedure question answering via RAG"
        },
        {
            "name": "Sessions",
            "description": "Conversation session management"
        },
        {
            "name": "Admin",
            "description": "Document ingestion and management (coordinator/superadmin only)"
        },
        {
            "name": "Health",
            "description": "Service health checks"
        }
    ]
}
