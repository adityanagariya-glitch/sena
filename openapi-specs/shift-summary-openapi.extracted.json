{
  "openapi": "3.1.0",
  "info": {
    "title": "Summary Consolidation API",
    "version": "1.0.0"
  },
  "paths": {
    "/summarize": {
      "post": {
        "tags": [
          "Summarization"
        ],
        "summary": "Consolidate N summaries into one",
        "description": "Accepts a list of text summaries, sends them to AWS Bedrock (Claude), and returns a single consolidated summary.",
        "operationId": "summarize_summarize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummarizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummarizeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "SummarizeRequest": {
        "properties": {
          "summaries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Summaries",
            "description": "List of text summaries to consolidate.",
            "examples": [
              [
                "Summary one.",
                "Summary two.",
                "Summary three."
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "summaries"
        ],
        "title": "SummarizeRequest"
      },
      "SummarizeResponse": {
        "properties": {
          "consolidated_summary": {
            "type": "string",
            "title": "Consolidated Summary",
            "description": "The consolidated summary produced by the model."
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "description": "Number of input tokens used by the model.",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "description": "Number of output tokens generated by the model.",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "consolidated_summary"
        ],
        "title": "SummarizeResponse"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
