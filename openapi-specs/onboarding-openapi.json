{
  "openapi": "3.0.0",
  "info": {
    "title": "SENA Onboarding Voice API",
    "description": "AI voice agent for NDIS participant onboarding. WebSocket protocol documented in docs/WS_PROTOCOL.md",
    "version": "0.1.0",
    "contact": {
      "name": "SENA AI Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8083",
      "description": "Development server"
    },
    {
      "url": "https://api.sena.example.com/onboarding",
      "description": "Production server"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Health check - liveness",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Health check - readiness",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "redis": {
                      "type": "string",
                      "example": "connected"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/onboarding/session": {
      "post": {
        "summary": "Create onboarding session",
        "tags": [
          "Session"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/onboarding/session/{session_id}/state": {
      "get": {
        "summary": "Get session state",
        "tags": [
          "Session"
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Participant-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found"
          }
        }
      },
      "put": {
        "summary": "Update session state",
        "tags": [
          "Session"
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Participant-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "State updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/onboarding/session/{session_id}/complete": {
      "post": {
        "summary": "Complete session",
        "tags": [
          "Session"
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/onboarding/session/{session_id}/errors": {
      "post": {
        "summary": "Report client validation error",
        "tags": [
          "Telemetry"
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Participant-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientValidationErrorRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Error recorded"
          }
        }
      }
    },
    "/v1/onboarding/_diag/bucket": {
      "get": {
        "summary": "Inspect cross-screen bucket (dev only)",
        "tags": [
          "Diagnostics"
        ],
        "parameters": [
          {
            "name": "tenant_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "participant_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bucket inspection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagBucketResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not available in production"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TokenUsage": {
        "type": "object",
        "description": "LLM token usage metrics including cache metrics",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Regular input tokens",
            "example": 2150
          },
          "output_tokens": {
            "type": "integer",
            "description": "Generated output tokens",
            "example": 450
          },
          "total_tokens": {
            "type": "integer",
            "description": "Sum of input + output tokens",
            "example": 2600
          },
          "cache_read_tokens": {
            "type": "integer",
            "description": "Tokens from cache hits (10% cost)",
            "example": 0
          },
          "cache_creation_tokens": {
            "type": "integer",
            "description": "Tokens used to create cache",
            "example": 0
          }
        }
      },
      "FormState": {
        "type": "object",
        "description": "Session form state with field values",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "participant_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "values": {
            "type": "object"
          },
          "completed": {
            "type": "boolean"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": [
          "participant_id",
          "step",
          "schema"
        ],
        "properties": {
          "participant_id": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "initial_state": {
            "type": "object",
            "nullable": true
          },
          "bootstrap": {
            "type": "object",
            "nullable": true
          },
          "locale": {
            "type": "string",
            "default": "en-AU"
          },
          "tenant_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateSessionResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "ws_url": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "resumption_handle": {
            "type": "string",
            "nullable": true
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "StateResponse": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/FormState"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "UpdateStateRequest": {
        "type": "object",
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "description": "Flat or nested field values to update"
          }
        }
      },
      "CompleteSessionResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "webhook_delivered": {
            "type": "boolean"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      },
      "ClientValidationErrorRequest": {
        "type": "object",
        "required": [
          "error_type",
          "error_message",
          "input_method",
          "field_id",
          "ts"
        ],
        "properties": {
          "error_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Type of validation error"
          },
          "error_message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Human-readable error message"
          },
          "input_method": {
            "type": "string",
            "enum": [
              "typed",
              "voice"
            ],
            "description": "How the invalid input was provided"
          },
          "field_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Field that failed validation"
          },
          "attempted_value": {
            "nullable": true,
            "description": "The value that failed validation"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the error"
          }
        }
      },
      "DiagBucketResponse": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "participant_id": {
            "type": "string"
          },
          "bucket_empty": {
            "type": "boolean"
          },
          "summary_count": {
            "type": "integer"
          },
          "step_numbers": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "step_labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cross_screen_enabled": {
            "type": "boolean"
          },
          "token_usage": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "HeaderAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-ID"
      }
    }
  }
}