# systemd unit to keep the Case-Review Streamlit UI running forever.
#
# Survives: terminal close, crashes (auto-restart), and reboots (auto-start).
#
# INSTALL (on the server, as root):
#   1. Verify the paths below match your box:
#        source ai-sena/bin/activate && which streamlit   # → ExecStart binary
#        pwd                                                # → WorkingDirectory (services/case_review)
#   2. Copy this file into place:
#        cp services/case_review/sena-streamlit.service /etc/systemd/system/sena-streamlit.service
#   3. Enable + start:
#        systemctl daemon-reload
#        systemctl enable --now sena-streamlit
#        systemctl status sena-streamlit
#
# Logs:    journalctl -u sena-streamlit -f
# Restart: systemctl restart sena-streamlit
# Stop:    systemctl stop sena-streamlit

[Unit]
Description=SENA Case Review — Streamlit UI
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/test/SENA/services/case_review
Environment=SENA_TEST_BASE_URL=http://localhost:8080/case-review
# --server.headless true stops Streamlit asking for an email / opening a browser.
# --server.baseUrlPath case-review-ui lets it sit behind nginx at /case-review-ui/.
ExecStart=/root/test/SENA/ai-sena/bin/streamlit run streamlit_app.py \
    --server.address 0.0.0.0 \
    --server.port 8501 \
    --server.headless true \
    --server.baseUrlPath case-review-ui
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
