  {
    "method": "GET",
    "path": "/organization/client/list/all-clients",
    "description": "Get all clients without pagination. PRIMARY ENDPOINT FOR LOOKING UP A CLIENT BY NAME OR ID — pass the name in the `search` query param to filter at the backend (faster than fetching all + matching locally). Supports filtering by one or more statuses and excluding statuses. All three params accept single value, comma-separated, or repeated params.",
    "parameters": [
      {
        "name": "statusIs",
        "type": "string",
        "required": false,
        "in": "query",
        "description": "Include only clients with these statuses. Single value (e.g. 'onboarded'), comma-separated ('onboarded,pending_verification'), or repeated. Common values: onboarded, pending_verification, invited, rejected."
      },
      {
        "name": "statusIsNot",
        "type": "string",
        "required": false,
        "in": "query",
        "description": "Exclude clients with these statuses. Same formats as statusIs. Common values: rejected, invited."
      },
      {
        "name": "search",
        "type": "string",
        "required": false,
        "in": "query",
        "description": "Search by client name (matches first / last / preferred name). USE THIS whenever the user asks about a client by name (e.g. 'Tanishq', 'John Doe'). Backend does the matching — no need to fetch all clients."
      }
    ]
  },
