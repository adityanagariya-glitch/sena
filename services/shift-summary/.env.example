# ── Application ──────────────────────────────────────────────
APP_TITLE=Summary Consolidation API
APP_VERSION=1.0.0
APP_ENV=development                  # development | production

# ── Security ─────────────────────────────────────────────────
API_KEY=your-secret-api-key-here     # Set a strong random value in production

# ── AWS / Bedrock ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-southeast-2

# ── Bedrock Model ─────────────────────────────────────────────
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.3              # 0.0 – 1.0; lower = more deterministic

# ── Validation ───────────────────────────────────────────────
MIN_SUMMARIES=1
MAX_SUMMARIES=5
MIN_SUMMARY_LENGTH=1                 # characters per individual summary
MAX_SUMMARY_LENGTH=5000              # characters per individual summary



