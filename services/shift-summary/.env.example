# ── Application ──────────────────────────────────────────────
SHIFT_SUMMARY_APP_TITLE=Summary Consolidation API
SHIFT_SUMMARY_APP_VERSION=1.0.0
SHIFT_SUMMARY_APP_ENV=development                  # development | production

# ── Security ─────────────────────────────────────────────────
SHIFT_SUMMARY_API_KEY=your-secret-api-key-here     # Set a strong random value in production

# ── AWS / Bedrock ─────────────────────────────────────────────
SHIFT_SUMMARY_AWS_ACCESS_KEY_ID=your-access-key-id
SHIFT_SUMMARY_AWS_SECRET_ACCESS_KEY=your-secret-access-key
SHIFT_SUMMARY_AWS_REGION=ap-southeast-2

# ── Bedrock Model ─────────────────────────────────────────────
SHIFT_SUMMARY_BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
SHIFT_SUMMARY_BEDROCK_MAX_TOKENS=1024
SHIFT_SUMMARY_BEDROCK_TEMPERATURE=0.3              # 0.0 – 1.0; lower = more deterministic

# ── Validation ───────────────────────────────────────────────
SHIFT_SUMMARY_MIN_SUMMARIES=1
SHIFT_SUMMARY_MAX_SUMMARIES=5
SHIFT_SUMMARY_MIN_SUMMARY_LENGTH=1                 # characters per individual summary
SHIFT_SUMMARY_MAX_SUMMARY_LENGTH=5000              # characters per individual summary



