{
  "version": "v1",
  "step_id": "ndis_plan_details",
  "step_label": "NDIS Plan Details",
  "progress_percent": 60,
  "voice_coverage": [],
  "voice_repeatable_sections": ["ndis_goals"],
  "sections": [
    {
      "id": "plan_info",
      "label": "Plan information",
      "fields": [
        {"id": "ndis_number", "type": "text", "label": "NDIS Number", "required": true},
        {"id": "plan_start", "type": "date", "label": "Plan Start Date", "required": true},
        {"id": "plan_end", "type": "date", "label": "Plan End Date", "required": true},
        {
          "id": "plan_management",
          "type": "enum",
          "label": "Plan Management",
          "required": true,
          "options": ["Plan Managed", "Self Managed", "Agency Managed"],
          "default": "Plan Managed"
        },
        {"id": "plan_manager", "type": "text", "label": "Plan Manager Name", "required": true},
        {"id": "contact_email", "type": "email", "label": "Plan Manager Contact Email", "required": true},
        {"id": "billing_email", "type": "email", "label": "Billing Email", "required": true}
      ]
    },
    {
      "id": "ndis_goals",
      "label": "NDIS Goals",
      "repeatable": {"min": 1, "max": 10},
      "item_fields": [
        {"id": "goal", "type": "textarea", "label": "Goal description", "required": true}
      ]
    },
    {
      "id": "support_coordinator",
      "label": "Support Coordinator",
      "fields": [
        {"id": "coordinator_name", "type": "text", "label": "Support Coordinator Name", "required": false},
        {"id": "coordinator_email", "type": "email", "label": "Support Coordinator Email", "required": false}
      ]
    },
    {
      "id": "allocated_funding",
      "label": "Allocated funding for this provider",
      "fields": [
        {"id": "daily_living", "type": "currency", "label": "Daily Living ($)", "required": false},
        {"id": "social_community", "type": "currency", "label": "Social & Community ($)", "required": false},
        {"id": "support_coordination", "type": "currency", "label": "Support Coordination ($)", "required": false}
      ]
    },
    {
      "id": "support_schedule",
      "label": "Schedule of Supports",
      "repeatable": {"min": 1, "max": 5},
      "item_fields": [
        {"id": "support_purpose",  "type": "text",     "label": "Support Purpose",  "required": true},
        {"id": "support_category", "type": "text",     "label": "Support Category", "required": true},
        {"id": "support_item",     "type": "text",     "label": "Support Item",     "required": true},
        {"id": "description",      "type": "textarea", "label": "Description",      "required": false},
        {
          "id": "frequency",
          "type": "enum",
          "label": "Frequency",
          "required": true,
          "options": ["AS_REQUIRED", "DAILY", "WEEKLY", "FORTNIGHTLY", "MONTHLY", "ONCE_OFF"]
        },
        {"id": "preferred_schedule", "type": "text", "label": "Preferred Schedule", "required": true}
      ]
    }
  ]
}
