        "url": "{{base_url}}/api/v1/classify",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"conv_trim_001\",\n  \"provider_id\": \"org_abc_123\",\n  \"current_message\": {\n    \"role\": \"support_worker\",\n    \"text\": \"Everything is going fine today.\",\n    \"timestamp\": \"2025-06-01T10:15:00Z\"\n  },\n  \"history\": [\n    { \"role\": \"client\", \"text\": \"Message 1\", \"timestamp\": \"2025-06-01T10:01:00Z\" },\n    { \"role\": \"support_worker\", \"text\": \"Message 2\", \"timestamp\": \"2025-06-01T10:02:00Z\" },\n    { \"role\": \"client\", \"text\": \"Message 3\", \"timestamp\": \"2025-06-01T10:03:00Z\" },\n    { \"role\": \"support_worker\", \"text\": \"Message 4\", \"timestamp\": \"2025-06-01T10:04:00Z\" },\n    { \"role\": \"client\", \"text\": \"Message 5\", \"timestamp\": \"2025-06-01T10:05:00Z\" },\n    { \"role\": \"support_worker\", \"text\": \"Message 6\", \"timestamp\": \"2025-06-01T10:06:00Z\" },\n    { \"role\": \"client\", \"text\": \"Message 7\", \"timestamp\": \"2025-06-01T10:07:00Z\" },\n    { \"role\": \"support_worker\", \"text\": \"Message 8\", \"timestamp\": \"2025-06-01T10:08:00Z\" },\n    { \"role\": \"client\", \"text\": \"Message 9\", \"timestamp\": \"2025-06-01T10:09:00Z\" },\n    { \"role\": \"support_worker\", \"text\": \"Message 10\", \"timestamp\": \"2025-06-01T10:10:00Z\" }\n  ],\n  \"metadata\": {\n    \"shift_id\": \"shift_789\",\n    \"client_id\": \"client_456\",\n    \"worker_id\": \"worker_321\"\n  }\n}"
