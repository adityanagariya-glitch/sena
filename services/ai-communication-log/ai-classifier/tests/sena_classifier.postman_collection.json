        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const labels = pm.response.json().classifications.map(c => c.label);",
              "pm.test('Contains emergency', () => pm.expect(labels).to.include('emergency'));",
              "pm.test('Contains inappropriate', () => pm.expect(labels).to.include('inappropriate'));",
              "pm.test('Does not contain normal', () => pm.expect(labels).to.not.include('normal'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. History trimming — Send 10 messages",
      "request": {
