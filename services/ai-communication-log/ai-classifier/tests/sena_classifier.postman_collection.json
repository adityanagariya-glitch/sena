{
  "info": {
    "name": "Sena — Communication Log Classifier",
    "description": "Test collection for POST /api/v1/classify. Hits localhost:8000. Ensure FastAPI is running and AWS credentials are configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Normal — Professional message",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/classify",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"conv_normal_001\",\n  \"provider_id\": \"org_abc_123\",\n  \"current_message\": {\n    \"role\": \"support_worker\",\n    \"text\": \"Good morning! I'm here for your shift. How are you feeling today?\",\n    \"timestamp\": \"2025-06-01T10:05:00Z\"\n  },\n  \"history\": [\n    {\n      \"role\": \"client\",\n      \"text\": \"I'm doing okay, thank you for coming.\",\n      \"timestamp\": \"2025-06-01T10:03:00Z\"\n    }\n  ],\n  \"metadata\": {\n    \"shift_id\": \"shift_789\",\n    \"client_id\": \"client_456\",\n    \"worker_id\": \"worker_321\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const labels = body.classifications.map(c => c.label);",
              "pm.test('Contains normal label', () => pm.expect(labels).to.include('normal'));",
              "pm.test('Has confidence score', () => body.classifications.forEach(c => pm.expect(c.confidence).to.be.within(0, 1)));",
              "pm.test('Has reason', () => body.classifications.forEach(c => pm.expect(c.reason).to.be.a('string')));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Normal — No history (first message)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/classify",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"conv_normal_002\",\n  \"provider_id\": \"org_abc_123\",\n  \"current_message\": {\n    \"role\": \"support_worker\",\n    \"text\": \"Hi, I'm your support worker today. Ready to help whenever you need.\",\n    \"timestamp\": \"2025-06-01T10:05:00Z\"\n  },\n  \"history\": [],\n  \"metadata\": {\n    \"shift_id\": \"shift_789\",\n    \"client_id\": \"client_456\",\n    \"worker_id\": \"worker_321\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('messages_analysed is 1', () => pm.expect(body.messages_analysed).to.eql(1));",
              "const labels = body.classifications.map(c => c.label);",
              "pm.test('Contains normal label', () => pm.expect(labels).to.include('normal'));"
            ]
          }
        }
      ]
    },
