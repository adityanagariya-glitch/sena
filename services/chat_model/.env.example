# Chat Model Service Environment Variables
# Copy this file to .env and fill in your values
# Prefix: SENA_AI_

# ============================================================
# REQUIRED - Must be set before running
# ============================================================

# Google Gemini API key (get from console.cloud.google.com)
SENA_AI_GEMINI_API_KEY=your-gemini-api-key-here

# Redis connection URL
SENA_AI_REDIS_URL=redis://localhost:6379

# ============================================================
# OPTIONAL - Defaults provided, customize as needed
# ============================================================

# Service Configuration
SENA_AI_CHAT_MODEL_PORT=8085

# LLM Configuration
SENA_AI_GEMINI_MODEL_ID=gemini-3.1-flash-live-preview

# Database Configuration
SENA_AI_AI_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_db

# Data folder for RAG documents
SENA_AI_DATA_PATH=data/

# ============================================================
# AUTHENTICATION
# ============================================================

# Auth mode: "dev_header" (default) or "jwt"
# dev_header: Uses X-Tenant-ID, X-User-ID, X-User-Role headers
# jwt: Uses Bearer token validation (requires public key)
SENA_AI_AUTH_MODE=dev_header

# JWT configuration (only needed if AUTH_MODE=jwt)
SENA_AI_JWT_ISSUER=https://auth.example.com
SENA_AI_JWT_AUDIENCE=api.example.com
SENA_AI_JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# -----END PUBLIC KEY-----

# ============================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================

# Allowed origins for CORS (comma-separated)
SENA_AI_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# RATE LIMITING
# ============================================================

# Requests per minute per user
SENA_AI_RATE_LIMIT_PER_MINUTE=20

# ============================================================
# SESSION MANAGEMENT
# ============================================================

# Redis session TTL in seconds (default: 86400 = 1 day)
SENA_AI_REDIS_SESSION_TTL_SECONDS=86400

# ============================================================
# LOGGING
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR
SENA_AI_LOG_LEVEL=INFO

# ============================================================
# COMPLIANCE - PII DETECTION
# ============================================================

# Enable PII (Personally Identifiable Information) detection
SENA_AI_PII_DETECTION_ENABLED=false

# PII action: "reject" (block message) or "redact" (allow but mask)
SENA_AI_PII_ACTION=reject

# ============================================================
# COMPLIANCE - COST CONTROL
# ============================================================

# Maximum tokens per tenant per day
SENA_AI_COST_TOKENS_PER_TENANT_PER_DAY=100000

# Warning threshold (0.0-1.0), e.g., 0.8 = warn at 80% usage
SENA_AI_COST_TOKEN_WARNING_THRESHOLD=0.8

# ============================================================
# DATA RESIDENCY - GCP / VERTEX AI (AUSTRALIA)
# ============================================================

# Use Vertex AI instead of direct Gemini API (for data residency)
SENA_AI_USE_VERTEX_AI=true

# GCP project ID
SENA_AI_GCP_PROJECT_ID=my-gcp-project-id

# GCP region (australia-southeast1 for NDIS compliance)
SENA_AI_GCP_REGION=australia-southeast1

# Path to GCP service account JSON credentials
SENA_AI_GCP_CREDENTIALS_PATH=/path/to/service-account.json
