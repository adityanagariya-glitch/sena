{
  "method": "GET",
  "path": "/ai/client-data",
  "summary": "Get client activity data",
  "description": "Returns all client-related activity within a date range, grouped by day.",
  "queryParameters": [
    {
      "name": "clientId",
      "type": "uuid",
      "required": true,
      "description": "Client identifier."
    },
    {
      "name": "organizationId",
      "type": "uuid",
      "required": true,
      "description": "Organization identifier."
    },
    {
      "name": "dateFrom",
      "type": "date",
      "format": "YYYY-MM-DD",
      "required": true,
      "description": "Start date (inclusive)."
    },
    {
      "name": "dateTo",
      "type": "date",
      "format": "YYYY-MM-DD",
      "required": true,
      "description": "End date (inclusive)."
    },
    {
      "name": "page",
      "type": "integer",
      "required": false,
      "default": 1,
      "description": "Page number."
    },
    {
      "name": "limit",
      "type": "integer",
      "required": false,
      "default": 30,
      "description": "Number of days returned per page."
    }
  ],
  "response": {
    "success": true,
    "message": "Client data retrieved successfully",
    "data": {
      "clientId": "uuid",
      "clientName": "John Smith",
      "organizationId": "uuid",
      "dateFrom": "2026-05-01",
      "dateTo": "2026-05-31",
      "pagination": {
        "page": 1,
        "limit": 30,
        "totalPages": 1,
        "totalRecords": 31
      },
      "days": [
        {
          "date": "2026-05-01",
          "caseNotes": [],
          "shifts": [],
          "incidents": [],
          "restrictivePractices": [],
          "shiftFeedback": [],
          "clientComplaints": []
        }
      ]
    }
  }
}