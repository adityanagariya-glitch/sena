# systemd unit — Caddy reverse proxy fronting the SENA chatbot stack on :8080.
# Serves the Streamlit UI at /aichatbot/ and proxies the gateway/policy/staff.
# Replaces the docker nginx for the no-docker host deploy (do NOT run both — they
# both want :8080).
#
# INSTALL (on the server, as root):
#   cp sena-caddy.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now sena-caddy
#   systemctl status sena-caddy
#
# Logs:    journalctl -u sena-caddy -f
# Validate the config first:  caddy validate --config /root/test/SENA/Caddyfile

[Unit]
Description=SENA Caddy — reverse proxy (:8080) for chatbot UI + gateway
After=network-online.target sena-chatbot-gateway.service sena-chatbot-ui.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/test/SENA
# Adjust the caddy path if yours differs (run:  which caddy ).
ExecStart=/usr/bin/caddy run --config /root/test/SENA/Caddyfile
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
